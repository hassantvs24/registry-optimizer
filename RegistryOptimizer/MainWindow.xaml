<Window x:Class="RegistryOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RegistryOptimizer.ViewModels"
        xmlns:views="clr-namespace:RegistryOptimizer.Views"
        mc:Ignorable="d"
        Title="Registry Cleaner &amp; Optimizer"
        Width="1150" Height="760" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DefragViewModel}">
            <views:DefragView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RescueCenterViewModel}">
            <views:RescueCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="REGISTRY OPTIMIZER"
                           FontWeight="Bold" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource AccentHoverBrush}"
                           Margin="18,20,12,16"/>
                <ListBox Style="{StaticResource NavListBox}" ItemContainerStyle="{StaticResource NavListBoxItem}"
                         SelectedIndex="{Binding SelectedNavIndex}">
                    <!-- Icon strokes bind to the item Foreground so the selected page highlights them. -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4 11.5 L12 4 L20 11.5 M6.5 10 V20 H17.5 V10"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12 4 L13.4 10.6 L20 12 L13.4 13.4 L12 20 L10.6 13.4 L4 12 L10.6 10.6 Z M18.5 3.5 L19 5 L20.5 5.5 L19 6 L18.5 7.5 L18 6 L16.5 5.5 L18 5 Z"/>
                            <TextBlock Text="Registry Cleaner" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4.5 17 A8 8 0 1 1 19.5 17 M12 17 L16 10.5"/>
                            <TextBlock Text="Registry Optimizer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12 3 L5 6 V11 C5 16 8 19.5 12 21 C16 19.5 19 16 19 11 V6 Z M9 11.5 L11.3 13.8 L15.5 9.6"/>
                            <TextBlock Text="Rescue Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4 7 H20 M4 12 H20 M4 17 H20 M8.5 7 A2 2 0 1 0 12.5 7 A2 2 0 1 0 8.5 7 M12.5 12 A2 2 0 1 0 16.5 12 A2 2 0 1 0 12.5 12 M5.5 17 A2 2 0 1 0 9.5 17 A2 2 0 1 0 5.5 17"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="0" Grid.ColumnSpan="1" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0" IsHitTestVisible="False"/>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
