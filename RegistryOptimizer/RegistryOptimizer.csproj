<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RegistryOptimizer</AssemblyName>
    <RootNamespace>RegistryOptimizer</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>Registry Cleaner &amp; Optimizer</AssemblyTitle>
    <Description>Scan and fix registry issues, defragment and compact registry hives.</Description>
    <Company>RegistryOptimizer</Company>
    <Authors>RegistryOptimizer</Authors>
    <Product>Registry Cleaner &amp; Optimizer</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AlphaVSS" Version="2.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

</Project>
