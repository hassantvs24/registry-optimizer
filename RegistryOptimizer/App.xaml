<Application x:Class="RegistryOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RegistryOptimizer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBoolConverter x:Key="InverseBool"/>
            <local:EnumToBoolConverter x:Key="EnumToBool"/>
            <local:GaugeArcConverter x:Key="GaugeArc"/>
            <local:BytesToMbConverter x:Key="BytesToMb"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
