<UserControl x:Class="RegistryOptimizer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RegistryOptimizer.ViewModels"
             d:DesignHeight="600" d:DesignWidth="800"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="16">
            <TextBlock Text="Dashboard" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource InfoBanner}">
                <TextBlock Style="{StaticResource InfoBannerText}"
                           Text="New here? The usual routine: scan your registry, review the findings and fix them, then analyze fragmentation and optimize. Optimization finishes over the next two reboots."/>
            </Border>

            <UniformGrid Columns="2" Margin="0,4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LAST SCAN" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LastScanText}" FontSize="22" FontWeight="SemiBold" Margin="0,6"/>
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding LastScanIssuesText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REGISTRY FRAGMENTATION" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FragmentationText}" FontSize="22" FontWeight="SemiBold" Margin="0,6"/>
                        <TextBlock Style="{StaticResource HintText}" Text="Lower is better."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LAST OPTIMIZATION" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LastDefragText}" FontSize="22" FontWeight="SemiBold" Margin="0,6"/>
                        <TextBlock Style="{StaticResource HintText}" Text="Boot-time hive compaction."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="QUICK ACTIONS" Style="{StaticResource HintText}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Scan registry" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenScanCommand}" MinWidth="130">
                                <Button.ToolTip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="260"
                                               Text="Open the Registry Cleaner and start scanning for invalid and leftover registry entries."/>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Optimize" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenOptimizerCommand}" MinWidth="110" Margin="8,0,0,0">
                                <Button.ToolTip>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="260"
                                               Text="Open the Registry Optimizer to measure fragmentation and compact the registry at boot time."/>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
