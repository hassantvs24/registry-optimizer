<UserControl x:Class="RegistryOptimizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="900">
    <ScrollViewer>
        <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource InfoBanner}">
                <TextBlock Style="{StaticResource InfoBannerText}"
                           Text="Excluded categories are skipped during scans. The weekly scan runs silently in the background and fixes only Safe items, so it stays low-risk."/>
            </Border>

            <GroupBox Header="Scan exclusions">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ExcludedCategories}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                          Width="200" Margin="0,4,8,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Backup retention">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="60" Text="{Binding RetentionSessions, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center"/>
                    <TextBlock Text="backup sessions (1-50)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Weekly scheduled scan">
                <StackPanel>
                    <CheckBox Content="Enable weekly Quick scan with automatic fix of safe issues"
                              IsChecked="{Binding IsScheduled, Mode=TwoWay}">
                        <CheckBox.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="280"
                                       Text="Creates a Windows Task Scheduler task that scans once a week and automatically fixes only the Safe items. Runs silently — you can review the log in C:\ProgramData\RegistryOptimizer\scheduled-scan-log.txt."/>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Margin="24,10,0,0" IsEnabled="{Binding IsScheduled}">
                        <TextBlock Text="Day:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DaysOfWeek}" SelectedItem="{Binding ScheduleDay}"
                                  MinWidth="130" Margin="8,0,16,0"/>
                        <TextBlock Text="Time (HH:mm):" VerticalAlignment="Center"/>
                        <TextBox Width="70" Text="{Binding TimeOfDay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button Content="Apply schedule" Style="{StaticResource PrimaryButton}" MinWidth="140"
                            HorizontalAlignment="Left" Margin="24,12,0,0"
                            Command="{Binding ApplyScheduleCommand}">
                        <Button.ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="240"
                                       Text="Creates or updates the weekly task in Windows Task Scheduler."/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </GroupBox>

            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="120"
                    HorizontalAlignment="Left" Margin="6,16,6,20" Command="{Binding SaveCommand}">
                <Button.ToolTip>
                    <TextBlock TextWrapping="Wrap" MaxWidth="240"
                               Text="Saves exclusions and retention. Use Apply schedule above for the weekly task."/>
                </Button.ToolTip>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
